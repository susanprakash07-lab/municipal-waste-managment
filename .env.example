# ==============================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# --------------------------------------------------------------
# For Local Development:
MONGO_URI=mongodb://127.0.0.1:27017/municipal_waste_management

# For Vercel Deployment (Required):
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables
# Example MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/municipal_waste_management?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_municipal_waste_mgmt_key_2026_secure
JWT_EXPIRE=7d

# Frontend API URL (Optional, defaults to relative '/api' on Vercel)
# VITE_API_URL=/api

